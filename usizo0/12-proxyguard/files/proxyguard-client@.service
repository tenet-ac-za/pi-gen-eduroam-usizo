[Unit]
Description=Proxy WireGuard UDP traffic over TCP and HTTP(S) for %I
After=network-online.target
Wants=network-online.target
Before=wg-quick.target
PartOf=proxyguard-client.target

[Service]
Type=exec
AmbientCapabilities=CAP_NET_ADMIN
RuntimeDirectory=proxyguard-client
ExecStartPre=-/usr/local/sbin/proxyguard-client-config.sh \
    /etc/wireguard/%i.conf \
    /run/proxyguard-client/%i.env
Environment=FWMARK=54321
EnvironmentFile=-/etc/default/proxyguard-client
EnvironmentFile=-/run/proxyguard-client/%i.env
ExecStart=proxyguard-client -listen-port ${LISTEN_PORT} -forward-port ${FORWARD_PORT} -to ${TO} -peer-ips ${PEER_IPS} -fwmark ${FWMARK}
ExecStopPost=rm -f /run/proxyguard-client/%i.env
Restart=on-failure
PrivateDevices=yes

[Install]
WantedBy=multi-user.target
