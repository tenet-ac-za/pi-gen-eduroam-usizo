[Unit]
Description=WireGuard/eduVPN for eduroam usizo
After=network-online.target
Before=wg-quick.target
Before=proxyguard-client.target

[Service]
Type=oneshot
EnvironmentFile=/etc/default/usizo
EnvironmentFile-=/boot/firmware/usizo.cfg
User=root
Group=root
UMask=0077
RemainAfterExit=yes
ExecStart=/usr/local/sbin/usizo-eduvpn-config.sh \
    rtable=${EDUVPN_TABLE} \
    "${EDUVPN_CONFIG}"
ExecStart=/usr/bin/chmod 600 /etc/wireguard/wg0.conf
ExecStart=/bin/sh -c 'echo "${EDUVPN_TABLE} eduvpn" > /etc/iproute2/rt_tables.d/usizo-eduvpn.conf'

[Install]
WantedBy=multi-user.target
